# Railway backend URL (no trailing slash)
VITE_API_URL=https://your-app.up.railway.app

# Cognito (public — safe in frontend build)
VITE_COGNITO_REGION=ca-central-1
VITE_COGNITO_USER_POOL_ID=<>
VITE_COGNITO_CLIENT_ID=your_public_client_id_without_secret
VITE_COGNITO_USER_ATTRIBUTE=custom:user
VITE_COGNITO_APPROVED_VALUE=approved

# Leave VITE_COGNITO_* empty for local dev without login (uses localhost API)
